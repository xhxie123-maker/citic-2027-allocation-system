  "engine_formulas": {
    "score": "sum(weight_i * score_i), score_i in [0,100], neutral=50",
    "earnings_score": "50 + (growth - 9.5) * 8",
    "valuation_score": "50 + (50 - percentile) * 1.2",
    "liquidity_score": "50 + 26*fed_cut + 15*southbound + 9*domestic",
    "ai_score": "50 + (capex_growth - 20) * 2",
    "position_multiplier": "clamp(1 + (score-50)/50*0.35, 0.60, 1.35)",
    "equity_weight": "clamp(tier_equity * multiplier, 25, 95); micro capped at 90",
    "single_track_cap": 15,
    "bond_weight_delta": "(60 - risk_score) * 0.10  # 风险分越低（事件发酵）越加债",
    "unlock_window": "current month in {2027-01, 2027-03} -> hkgrow -20pp (base -15pp) 且 ai -4pp"
  },
